    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viteme.Application\Viteme.Application.csproj" />
    <ProjectReference Include="..\Viteme.Infrastructure\Viteme.Infrastructure.csproj" />
  </ItemGroup>

