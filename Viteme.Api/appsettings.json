{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "viteme-api",
    "Audiencia": "viteme-web",
    "MinutosAcesso": 15
  },
  "RateLimiting": {
    "Habilitar": true,
    "LoginPorMinuto": 5,
    "CadastroPorMinuto": 10,
    "CodigoSmsPorMinuto": 5,
    "DenunciasPorMinuto": 5,
    "ValidacaoCertificadoPorMinuto": 30,
    "ConsultaCnpjPorMinuto": 5,
    "RedefinicaoSenhaPorMinuto": 5
  },
  "Email": {
    "RemetenteEmail": "nao-responda@viteme.app",
    "RemetenteNome": "Viteme",
    "UrlRedefinicaoSenha": "https://viteme.app/redefinir-senha",
    "SendGrid": {
      "ChaveApi": ""
    }
  },
  "Cnpj": {
    "UrlBase": "https://brasilapi.com.br/api/cnpj/v1/",
    "TimeoutSegundos": 10,
    "UsarStub": false
  },
  "Sms": {
    "LogarConteudo": false
  },
  "Tarefas": {
    "Habilitar": true,
    "IntervaloEncerramentoMinutos": 15,
    "IntervaloReservasMinutos": 1,
    "IntervaloSmsMinutos": 1,
    "IntervaloLembretesMinutos": 15
  },
  "Certificados": {
    "UrlValidacao": "https://viteme.app/validar"
  },
  "Gateway": {
    "Provedor": "Stub",
    "Asaas": {
      "UrlBase": "https://api-sandbox.asaas.com/v3",
      "ChaveApi": "",
      "TokenWebhook": ""
    },
    "Stub": {
      "HabilitarSimulador": false
    }
  },
  "Proxy": {
    "ConfiarEmCabecalhosEncaminhados": false,
    "SaltosConfiaveis": 1
  },
  "Swagger": {
    "Habilitar": false
  }
}
