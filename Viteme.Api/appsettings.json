{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "viteme-api",
    "Audiencia": "viteme-web",
    "MinutosAcesso": 15
  },
  "RateLimiting": {
    "Habilitar": true,
    "LoginPorMinuto": 5,
    "CadastroPorMinuto": 10,
    "CodigoSmsPorMinuto": 5
  },
  "Sms": {
    "LogarConteudo": false
  },
  "Proxy": {
    "ConfiarEmCabecalhosEncaminhados": false
  },
  "Swagger": {
    "Habilitar": false
  }
}
