{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Emissor": "viteme-api",
    "Audiencia": "viteme-web",
    "MinutosAcesso": 15
  },
  "RateLimiting": {
    "Habilitar": true,
    "LoginPorMinuto": 5,
    "CadastroPorMinuto": 10,
    "CodigoSmsPorMinuto": 5,
    "DenunciasPorMinuto": 5,
    "ValidacaoCertificadoPorMinuto": 30
  },
  "Sms": {
    "LogarConteudo": false
  },
  "Tarefas": {
    "Habilitar": true,
    "IntervaloEncerramentoMinutos": 15,
    "IntervaloReservasMinutos": 1,
    "IntervaloSmsMinutos": 1,
    "IntervaloLembretesMinutos": 15
  },
  "Certificados": {
    "UrlValidacao": "https://viteme.app/validar"
  },
  "Gateway": {
    "Stub": {
      "HabilitarSimulador": false
    }
  },
  "Proxy": {
    "ConfiarEmCabecalhosEncaminhados": false
  },
  "Swagger": {
    "Habilitar": false
  }
}
